# =========================================================
# 1) Build outputs (C/C++ / CMake / Ninja)
# =========================================================
# Common build folders
build/
Build/
out/
bin/
obj/

# Any nested build/out folders
**/build/
**/Build/
**/out/
**/bin/
**/obj/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/
cmake-build-*/
CMakeUserPresets.json.user
compile_commands.json

# Ninja files/logs
.ninja_log
.ninja_deps
build.ninja
rules.ninja
*.ninja

# =========================================================
# 2) C/C++ compiled artifacts
# =========================================================
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
*.app

# Debug / symbols
*.pdb
*.ipdb
*.iobj
*.ilk
*.idb
*.pch
*.tlog
*.lastbuildstate
*.dmp

# =========================================================
