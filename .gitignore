# =========================================================
# VS cache/settings
.vs/
*.suo
*.user
*.userosscache
*.slnx

# IntelliSense / browse database
*.VC.db
*.VC.VC.opendb
ipch/
*.ipch

# MSBuild output folders (often created by VS)
Debug/
Release/
x64/
Win32/
**/Debug/
**/Release/
**/x64/
**/Win32/

# Visual Studio temp
*.aps
*.ncb
*.opensdf
*.sdf

